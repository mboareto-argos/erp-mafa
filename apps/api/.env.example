DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_mafa?schema=public"
PORT=3001

# Segredo de assinatura JWT — gerar um valor proprio por ambiente, nunca
# reaproveitar (docs/architecture/overview.md, secao 9.3).
JWT_SECRET="replace-with-a-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_PREAUTH_EXPIRES_IN="5m"
