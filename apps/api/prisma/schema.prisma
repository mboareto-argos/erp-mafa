// Schema inicial — modulos Identity, Tenancy e Catalog (fase 1 do roadmap,
// docs/architecture/overview.md secao 15). Demais modulos entram conforme o
// roadmap avanca — ver TA-DATA-004 (modelagem final incremental, nunca ad-hoc).
//
// Convencoes aplicadas em todo o schema:
// - TA-DATA-001: toda tabela operacional tem id/company_id/created_at/updated_at/
//   created_by/deleted_at.
// - TA-DATA-002: indice composto iniciando por company_id em toda tabela operacional.
// - TA-DATA-003: unicidade de negocio composta com company_id, exceto entidades
//   verdadeiramente globais (users.email de login).
// - TA-DOMAIN-001: valores monetarios usam Decimal, nunca float/double.
//
// Company e User sao as duas excecoes a TA-DATA-001: Company e a raiz do tenant
// (nao pertence a uma empresa) e User e global por desenho de autenticacao
// (TA-DATA-003) — o vinculo com empresa(s) e feito via Membership.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & Tenancy (docs/architecture/overview.md, secao 6.1)
// ---------------------------------------------------------------------------

enum CompanyStatus {
  active
  inactive
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  document         String?
  segment          String?
  plan             String?
  brandAccentColor String        @default("#C49A28") @map("brand_accent_color")
  status           CompanyStatus @default(active)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  memberships             Membership[]
  invitations             Invitation[]
  refreshTokens           RefreshToken[]
  categories              Category[]
  brands                  Brand[]
  tags                    Tag[]
  products                Product[]
  productVariants         ProductVariant[]
  productPrices           ProductPrice[]
  productTags             ProductTag[]
  stockBalances           StockBalance[]
  stockMovements          StockMovement[]
  stockAdjustments        StockAdjustment[]
  stockReservations       StockReservation[]
  suppliers               Supplier[]
  purchases               Purchase[]
  purchaseItems           PurchaseItem[]
  purchaseReceipts        PurchaseReceipt[]
  purchaseReceiptItems    PurchaseReceiptItem[]
  purchaseCostAllocations PurchaseCostAllocation[]
  customers               Customer[]
  paymentMethods          PaymentMethod[]
  sales                   Sale[]
  saleItems               SaleItem[]
  salePayments            SalePayment[]
  saleReturns             SaleReturn[]
  saleReturnItems         SaleReturnItem[]
  financialAccounts       FinancialAccount[]
  financialTransactions   FinancialTransaction[]
  transfers               Transfer[]
  receivables             Receivable[]
  receivablePayments      ReceivablePayment[]
  payables                Payable[]
  payablePayments         PayablePayment[]
  expenses                Expense[]
  auditLogs               AuditLog[]
  idempotencyRecords      IdempotencyRecord[]

  @@map("companies")
}

enum UserStatus {
  active
  invited
  blocked
}

// Entidade global por desenho de autenticacao (TA-DATA-003) — um mesmo usuario
// pode ter Membership em varias empresas.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  memberships                    Membership[]
  refreshTokens                  RefreshToken[]
  createdMemberships             Membership[]             @relation("MembershipCreatedBy")
  createdInvitations             Invitation[]             @relation("InvitationCreatedBy")
  createdCategories              Category[]               @relation("CategoryCreatedBy")
  createdBrands                  Brand[]                  @relation("BrandCreatedBy")
  createdTags                    Tag[]                    @relation("TagCreatedBy")
  createdProducts                Product[]                @relation("ProductCreatedBy")
  createdProductVariants         ProductVariant[]         @relation("ProductVariantCreatedBy")
  createdProductPrices           ProductPrice[]           @relation("ProductPriceCreatedBy")
  createdProductTags             ProductTag[]             @relation("ProductTagCreatedBy")
  createdStockMovements          StockMovement[]          @relation("StockMovementCreatedBy")
  createdStockAdjustments        StockAdjustment[]        @relation("StockAdjustmentCreatedBy")
  approvedStockAdjustments       StockAdjustment[]        @relation("StockAdjustmentApprovedBy")
  createdStockReservations       StockReservation[]       @relation("StockReservationCreatedBy")
  createdSuppliers               Supplier[]               @relation("SupplierCreatedBy")
  createdPurchases               Purchase[]               @relation("PurchaseCreatedBy")
  createdPurchaseItems           PurchaseItem[]           @relation("PurchaseItemCreatedBy")
  createdPurchaseReceipts        PurchaseReceipt[]        @relation("PurchaseReceiptCreatedBy")
  createdPurchaseReceiptItems    PurchaseReceiptItem[]    @relation("PurchaseReceiptItemCreatedBy")
  createdPurchaseCostAllocations PurchaseCostAllocation[] @relation("PurchaseCostAllocationCreatedBy")
  createdCustomers               Customer[]               @relation("CustomerCreatedBy")
  createdPaymentMethods          PaymentMethod[]          @relation("PaymentMethodCreatedBy")
  createdSales                   Sale[]                   @relation("SaleCreatedBy")
  createdSaleItems               SaleItem[]               @relation("SaleItemCreatedBy")
  createdSalePayments            SalePayment[]            @relation("SalePaymentCreatedBy")
  createdSaleReturns             SaleReturn[]             @relation("SaleReturnCreatedBy")
  createdSaleReturnItems         SaleReturnItem[]         @relation("SaleReturnItemCreatedBy")
  createdFinancialAccounts       FinancialAccount[]       @relation("FinancialAccountCreatedBy")
  createdFinancialTransactions   FinancialTransaction[]   @relation("FinancialTransactionCreatedBy")
  createdTransfers               Transfer[]               @relation("TransferCreatedBy")
  createdReceivables             Receivable[]             @relation("ReceivableCreatedBy")
  createdReceivablePayments      ReceivablePayment[]      @relation("ReceivablePaymentCreatedBy")
  createdPayables                Payable[]                @relation("PayableCreatedBy")
  createdPayablePayments         PayablePayment[]         @relation("PayablePaymentCreatedBy")
  createdExpenses                Expense[]                @relation("ExpenseCreatedBy")
  auditLogs                      AuditLog[]               @relation("AuditLogCreatedBy")

  @@map("users")
}

// Catalogo global de papeis do sistema (secao 9.2 do Documento de Negocio).
// Nao e uma tabela operacional por empresa no MVP — permissoes personalizadas
// por empresa sao extensao futura (secao 6.3 do Design System).
enum RoleName {
  owner
  admin
  sales
  inventory
  finance
  viewer
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  invitations Invitation[]

  @@map("roles")
}

enum MembershipStatus {
  active
  invited
  removed
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(invited)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  createdBy String?          @map("created_by") @db.Uuid
  deletedAt DateTime?        @map("deleted_at")

  company       Company @relation(fields: [companyId], references: [id])
  user          User    @relation(fields: [userId], references: [id])
  role          Role    @relation(fields: [roleId], references: [id])
  createdByUser User?   @relation("MembershipCreatedBy", fields: [createdBy], references: [id])

  @@unique([companyId, userId])
  @@index([companyId, status])
  @@map("memberships")
}

model Invitation {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  email     String
  roleId    String    @map("role_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  company       Company @relation(fields: [companyId], references: [id])
  role          Role    @relation(fields: [roleId], references: [id])
  createdByUser User?   @relation("InvitationCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId, email])
  @@map("invitations")
}

// Sessao de refresh token (§9.1: access curto + refresh rotativo revogavel).
// Global como User (TA-DATA-003) — a empresa ativa da sessao e' um dado da
// sessao, nao faz da tabela "operacional" no sentido de TA-DATA-001.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// Trilha append-only das operações sensíveis. Não há endpoint de alteração
// ou remoção: a retenção será uma política administrativa futura.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  reason      String?
  origin      String   @default("api")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation("AuditLogCreatedBy", fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@map("audit_logs")
}

// Protege comandos que geram estoque ou caixa contra repetição de requisição.
// A resposta concluída é reaproveitada para a mesma chave, empresa e operação.
model IdempotencyRecord {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  operation   String
  key         String    @map("idempotency_key")
  response    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, operation, key])
  @@index([companyId, completedAt])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------------------
// Catalog (docs/architecture/overview.md, secao 6.2)
// ---------------------------------------------------------------------------

enum CategoryStatus {
  active
  inactive
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  name      String
  status    CategoryStatus @default(active)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  createdBy String?        @map("created_by") @db.Uuid
  deletedAt DateTime?      @map("deleted_at")

  company       Company   @relation(fields: [companyId], references: [id])
  createdByUser User?     @relation("CategoryCreatedBy", fields: [createdBy], references: [id])
  products      Product[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("categories")
}

enum BrandStatus {
  active
  inactive
}

model Brand {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  name      String
  status    BrandStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  createdBy String?     @map("created_by") @db.Uuid
  deletedAt DateTime?   @map("deleted_at")

  company       Company   @relation(fields: [companyId], references: [id])
  createdByUser User?     @relation("BrandCreatedBy", fields: [createdBy], references: [id])
  products      Product[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("brands")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  company       Company      @relation(fields: [companyId], references: [id])
  createdByUser User?        @relation("TagCreatedBy", fields: [createdBy], references: [id])
  productTags   ProductTag[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("tags")
}

enum ProductStatus {
  active
  inactive
}

model Product {
  id         String        @id @default(uuid()) @db.Uuid
  companyId  String        @map("company_id") @db.Uuid
  sku        String
  name       String
  categoryId String?       @map("category_id") @db.Uuid
  brandId    String?       @map("brand_id") @db.Uuid
  unit       String
  status     ProductStatus @default(active)
  aliases    String[]      @default([])
  // Estoque minimo (doc §10.3) — usado pelo alerta de estoque baixo do
  // Inventory (RN 10.7.8). Opcional: sem valor, o produto nunca aparece
  // no relatorio de estoque baixo.
  minStock   Decimal?      @map("min_stock") @db.Decimal(14, 3)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  createdBy  String?       @map("created_by") @db.Uuid
  deletedAt  DateTime?     @map("deleted_at")

  company       Company          @relation(fields: [companyId], references: [id])
  category      Category?        @relation(fields: [categoryId], references: [id])
  brand         Brand?           @relation(fields: [brandId], references: [id])
  createdByUser User?            @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  variants      ProductVariant[]
  prices        ProductPrice[]
  productTags   ProductTag[]

  @@unique([companyId, sku])
  @@index([companyId, status])
  @@map("products")
}

model ProductVariant {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  skuVariant String    @map("sku_variant")
  attributes Json
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String?   @map("created_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at")

  company              Company               @relation(fields: [companyId], references: [id])
  product              Product               @relation(fields: [productId], references: [id])
  createdByUser        User?                 @relation("ProductVariantCreatedBy", fields: [createdBy], references: [id])
  prices               ProductPrice[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  stockAdjustments     StockAdjustment[]
  stockReservations    StockReservation[]
  purchaseItems        PurchaseItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  saleItems            SaleItem[]
  saleReturnItems      SaleReturnItem[]

  @@unique([companyId, skuVariant])
  @@index([companyId, productId])
  @@map("product_variants")
}

// Preco e historico (RN-PRC-003): cada alteracao insere uma nova linha,
// nunca sobrescreve a anterior. costPrice e sempre calculado, nunca digitado
// diretamente pelo usuario (regra DS-FORM-004) — a UI nunca expõe este campo
// como input livre.
model ProductPrice {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  productVariantId String?   @map("product_variant_id") @db.Uuid
  costPrice        Decimal   @map("cost_price") @db.Decimal(14, 4)
  salePrice        Decimal   @map("sale_price") @db.Decimal(14, 2)
  margin           Decimal?  @db.Decimal(7, 4)
  effectiveFrom    DateTime  @map("effective_from")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  company        Company         @relation(fields: [companyId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  createdByUser  User?           @relation("ProductPriceCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId, productId, effectiveFrom])
  @@map("product_prices")
}

// Tabela de associacao explicita (em vez de m:n implicito do Prisma) para
// poder cumprir TA-DATA-001/002 (company_id + indice) tambem no vinculo.
model ProductTag {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  tagId     String    @map("tag_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  company       Company @relation(fields: [companyId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
  tag           Tag     @relation(fields: [tagId], references: [id])
  createdByUser User?   @relation("ProductTagCreatedBy", fields: [createdBy], references: [id])

  @@unique([productId, tagId])
  @@index([companyId])
  @@map("product_tags")
}

// ---------------------------------------------------------------------------
// Inventory (docs/architecture/overview.md, secao 6.3) — Fase 2 do roadmap
// ---------------------------------------------------------------------------

// Saldo materializado por variante — exceção documentada a TA-DATA-001
// (mesmo espírito de RefreshToken): não é um registro de negócio próprio,
// é a projeção reconciliável do somatório de StockMovement (RN 10.7.4/10.7.5
// do Documento de Negócio), por isso sem created_by/deleted_at.
model StockBalance {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  productVariantId  String   @map("product_variant_id") @db.Uuid
  quantityAvailable Decimal  @default(0) @map("quantity_available") @db.Decimal(14, 3)
  quantityReserved  Decimal  @default(0) @map("quantity_reserved") @db.Decimal(14, 3)
  quantityInTransit Decimal  @default(0) @map("quantity_in_transit") @db.Decimal(14, 3)
  updatedAt         DateTime @updatedAt @map("updated_at")

  company        Company        @relation(fields: [companyId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([companyId, productVariantId])
  @@map("stock_balances")
}

enum StockMovementType {
  in
  out
  adjustment
  return
}

// origin_type: 'purchase' | 'adjustment' | 'return' (futuro: 'sale')
enum StockMovementOriginType {
  purchase
  adjustment
  return
  sale
}

// Registro imutavel (RN 10.7.1/10.7.2/10.7.3 do Documento de Negocio) — toda
// alteracao de estoque gera uma movimentacao, nunca e apagada ou editada,
// correcoes sao movimentacoes compensatorias. Por ser append-only, nao tem
// updated_at/deleted_at (mesma logica de excecao documentada de StockBalance).
model StockMovement {
  id               String                  @id @default(uuid()) @db.Uuid
  companyId        String                  @map("company_id") @db.Uuid
  productVariantId String                  @map("product_variant_id") @db.Uuid
  type             StockMovementType
  quantity         Decimal                 @db.Decimal(14, 3)
  unitCost         Decimal?                @map("unit_cost") @db.Decimal(14, 4)
  originType       StockMovementOriginType @map("origin_type")
  originId         String                  @map("origin_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")
  createdBy        String?                 @map("created_by") @db.Uuid

  company        Company          @relation(fields: [companyId], references: [id])
  productVariant ProductVariant   @relation(fields: [productVariantId], references: [id])
  createdByUser  User?            @relation("StockMovementCreatedBy", fields: [createdBy], references: [id])
  adjustment     StockAdjustment?

  @@index([companyId, productVariantId])
  @@map("stock_movements")
}

// Complementa uma StockMovement(type=adjustment) com o motivo (RN 10.7.9) e
// a aprovacao (RN 10.7.10). requiresApproval e' calculado por um limiar
// simples no service; nao ha fila de aprovacao real ainda — approvedBy e'
// preenchido com o proprio ator no MVP (sinalizado no InventoryService).
model StockAdjustment {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  productVariantId String    @map("product_variant_id") @db.Uuid
  stockMovementId  String    @unique @map("stock_movement_id") @db.Uuid
  reason           String
  requiresApproval Boolean   @default(false) @map("requires_approval")
  approvedBy       String?   @map("approved_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  company        Company        @relation(fields: [companyId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  stockMovement  StockMovement  @relation(fields: [stockMovementId], references: [id])
  createdByUser  User?          @relation("StockAdjustmentCreatedBy", fields: [createdBy], references: [id])
  approvedByUser User?          @relation("StockAdjustmentApprovedBy", fields: [approvedBy], references: [id])

  @@index([companyId, productVariantId])
  @@map("stock_adjustments")
}

enum StockReservationStatus {
  active
  released
  consumed
}

// Modelo completo desde ja (TA-DATA-004), mas SEM service/endpoint nesta
// fase — quem cria uma reserva e' o Sales (Fase 3), que ainda nao existe.
// saleId fica sem FK por enquanto (referencia futura), como origin_id em
// StockMovement.
model StockReservation {
  id               String                 @id @default(uuid()) @db.Uuid
  companyId        String                 @map("company_id") @db.Uuid
  saleId           String                 @map("sale_id") @db.Uuid
  productVariantId String                 @map("product_variant_id") @db.Uuid
  quantity         Decimal                @db.Decimal(14, 3)
  status           StockReservationStatus @default(active)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  createdBy        String?                @map("created_by") @db.Uuid
  deletedAt        DateTime?              @map("deleted_at")

  company        Company        @relation(fields: [companyId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  createdByUser  User?          @relation("StockReservationCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId, productVariantId])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------
// Purchasing (docs/architecture/overview.md, secao 6.4) — Fase 2 do roadmap
// ---------------------------------------------------------------------------

enum SupplierStatus {
  active
  inactive
}

model Supplier {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  name        String
  document    String?
  contactName String?        @map("contact_name")
  phone       String?
  whatsapp    String?
  email       String?
  status      SupplierStatus @default(active)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  createdBy   String?        @map("created_by") @db.Uuid
  deletedAt   DateTime?      @map("deleted_at")

  company       Company    @relation(fields: [companyId], references: [id])
  createdByUser User?      @relation("SupplierCreatedBy", fields: [createdBy], references: [id])
  purchases     Purchase[]
  payables      Payable[]

  @@index([companyId, status])
  @@map("suppliers")
}

// Status simplificado do MVP (doc §10.6 ja lista estes 5 como o conjunto
// minimo). Sem status financeiro ainda — Payables e' Fase 4, fora de escopo.
enum PurchaseStatus {
  draft
  ordered
  partially_received
  received
  cancelled
}

model Purchase {
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  supplierId       String?        @map("supplier_id") @db.Uuid
  status           PurchaseStatus @default(draft)
  currency         String         @default("BRL")
  exchangeRate     Decimal?       @map("exchange_rate") @db.Decimal(14, 6)
  exchangeRateDate DateTime?      @map("exchange_rate_date")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  createdBy        String?        @map("created_by") @db.Uuid
  deletedAt        DateTime?      @map("deleted_at")

  company       Company           @relation(fields: [companyId], references: [id])
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  createdByUser User?             @relation("PurchaseCreatedBy", fields: [createdBy], references: [id])
  items         PurchaseItem[]
  receipts      PurchaseReceipt[]

  @@index([companyId, status])
  @@map("purchases")
}

// quantityReceived e' materializado (somatorio de PurchaseReceiptItem para
// este item), atualizado transacionalmente pelo receive() — mesmo padrao de
// "saldo materializado, desde que reconciliavel" ja usado em StockBalance.
model PurchaseItem {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  purchaseId             String    @map("purchase_id") @db.Uuid
  productVariantId       String    @map("product_variant_id") @db.Uuid
  quantity               Decimal   @db.Decimal(14, 3)
  unitCostOriginCurrency Decimal   @map("unit_cost_origin_currency") @db.Decimal(14, 4)
  quantityReceived       Decimal   @default(0) @map("quantity_received") @db.Decimal(14, 3)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  createdBy              String?   @map("created_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at")

  company        Company               @relation(fields: [companyId], references: [id])
  purchase       Purchase              @relation(fields: [purchaseId], references: [id])
  productVariant ProductVariant        @relation(fields: [productVariantId], references: [id])
  createdByUser  User?                 @relation("PurchaseItemCreatedBy", fields: [createdBy], references: [id])
  receiptItems   PurchaseReceiptItem[]

  @@index([companyId, purchaseId])
  @@map("purchase_items")
}

// Um recebimento (total ou parcial, RN 10.6.4/10.6.5/10.6.14). Evento
// concluido — nunca editado depois de criado, so tem created_at (mesma
// logica de imutabilidade de StockMovement).
model PurchaseReceipt {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  purchaseId String    @map("purchase_id") @db.Uuid
  receivedAt DateTime  @default(now()) @map("received_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at")

  company         Company                  @relation(fields: [companyId], references: [id])
  purchase        Purchase                 @relation(fields: [purchaseId], references: [id])
  createdByUser   User?                    @relation("PurchaseReceiptCreatedBy", fields: [createdBy], references: [id])
  items           PurchaseReceiptItem[]
  costAllocations PurchaseCostAllocation[]

  @@index([companyId, purchaseId])
  @@map("purchase_receipts")
}

// unitCostFinal ja inclui o rateio de custos adicionais (frete etc.) —
// e' o valor que alimenta o calculo de custo medio movel (RN 11.4).
model PurchaseReceiptItem {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  purchaseReceiptId String    @map("purchase_receipt_id") @db.Uuid
  purchaseItemId    String    @map("purchase_item_id") @db.Uuid
  productVariantId  String    @map("product_variant_id") @db.Uuid
  quantityReceived  Decimal   @map("quantity_received") @db.Decimal(14, 3)
  unitCostFinal     Decimal   @map("unit_cost_final") @db.Decimal(14, 4)
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  company         Company                  @relation(fields: [companyId], references: [id])
  purchaseReceipt PurchaseReceipt          @relation(fields: [purchaseReceiptId], references: [id])
  purchaseItem    PurchaseItem             @relation(fields: [purchaseItemId], references: [id])
  productVariant  ProductVariant           @relation(fields: [productVariantId], references: [id])
  createdByUser   User?                    @relation("PurchaseReceiptItemCreatedBy", fields: [createdBy], references: [id])
  costAllocations PurchaseCostAllocation[]

  @@index([companyId, purchaseReceiptId])
  @@map("purchase_receipt_items")
}

// Rateio de custos adicionais (frete etc.) por item do recebimento — metodo
// inicial proporcional ao valor dos itens (RN 10.6, exemplo de calculo §10.6).
model PurchaseCostAllocation {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  purchaseReceiptId     String    @map("purchase_receipt_id") @db.Uuid
  purchaseReceiptItemId String    @map("purchase_receipt_item_id") @db.Uuid
  type                  String
  amount                Decimal   @db.Decimal(14, 2)
  createdAt             DateTime  @default(now()) @map("created_at")
  createdBy             String?   @map("created_by") @db.Uuid
  deletedAt             DateTime? @map("deleted_at")

  company             Company             @relation(fields: [companyId], references: [id])
  purchaseReceipt     PurchaseReceipt     @relation(fields: [purchaseReceiptId], references: [id])
  purchaseReceiptItem PurchaseReceiptItem @relation(fields: [purchaseReceiptItemId], references: [id])
  createdByUser       User?               @relation("PurchaseCostAllocationCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId, purchaseReceiptId])
  @@map("purchase_cost_allocations")
}

// ---------------------------------------------------------------------------
// Customers, Payments, Sales (docs/architecture/overview.md, secao 6.5/6.6)
// — Fase 3 do roadmap, so venda a vista (ver plano da Fase 3: Receivables/
// CashFlow sao Fase 4, ainda nao existem).
// ---------------------------------------------------------------------------

enum CustomerStatus {
  active
  inactive
}

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  name      String
  whatsapp  String?
  phone     String?
  email     String?
  instagram String?
  birthDate DateTime?      @map("birth_date")
  status    CustomerStatus @default(active)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  createdBy String?        @map("created_by") @db.Uuid
  deletedAt DateTime?      @map("deleted_at")

  company       Company      @relation(fields: [companyId], references: [id])
  createdByUser User?        @relation("CustomerCreatedBy", fields: [createdBy], references: [id])
  sales         Sale[]
  receivables   Receivable[]

  @@index([companyId, status])
  @@map("customers")
}

enum PaymentMethodType {
  cash
  pix
  debit_card
  credit_card
  bank_transfer
  store_credit
  other
}

enum PaymentMethodStatus {
  active
  inactive
}

// Sem prazo de recebimento/parcelas ainda (venda so' a vista nesta fase —
// ver contexto do plano da Fase 3).
model PaymentMethod {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  type               PaymentMethodType
  name               String
  feeRate            Decimal?            @map("fee_rate") @db.Decimal(7, 4)
  feeFixed           Decimal?            @map("fee_fixed") @db.Decimal(14, 2)
  // Conta financeira de destino (§10.12) — opcional; quando presente, uma
  // venda a vista confirmada com esta forma de pagamento gera uma
  // FinancialTransaction real (ver Fase 4, SalesService.confirm()).
  financialAccountId String?             @map("financial_account_id") @db.Uuid
  status             PaymentMethodStatus @default(active)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  createdBy          String?             @map("created_by") @db.Uuid
  deletedAt          DateTime?           @map("deleted_at")

  company          Company           @relation(fields: [companyId], references: [id])
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  createdByUser    User?             @relation("PaymentMethodCreatedBy", fields: [createdBy], references: [id])
  salePayments     SalePayment[]

  @@index([companyId, status])
  @@map("payment_methods")
}

enum SalesChannel {
  presencial
  whatsapp
  instagram
  catalogo
  outro
}

enum SaleStatus {
  draft
  confirmed
  cancelled
  partially_returned
  returned
}

model Sale {
  id                    String       @id @default(uuid()) @db.Uuid
  companyId             String       @map("company_id") @db.Uuid
  customerId            String?      @map("customer_id") @db.Uuid
  channel               SalesChannel
  status                SaleStatus   @default(draft)
  subtotal              Decimal      @default(0) @db.Decimal(14, 2)
  discount              Decimal      @default(0) @db.Decimal(14, 2)
  total                 Decimal      @default(0) @db.Decimal(14, 2)
  cmvCalculated         Decimal?     @map("cmv_calculated") @db.Decimal(14, 2)
  grossProfitCalculated Decimal?     @map("gross_profit_calculated") @db.Decimal(14, 2)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  createdBy             String?      @map("created_by") @db.Uuid
  deletedAt             DateTime?    @map("deleted_at")

  company       Company       @relation(fields: [companyId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  createdByUser User?         @relation("SaleCreatedBy", fields: [createdBy], references: [id])
  items         SaleItem[]
  payments      SalePayment[]
  returns       SaleReturn[]
  receivables   Receivable[]

  @@index([companyId, status])
  @@map("sales")
}

// quantityReturned e' materializado (somatorio de SaleReturnItem deste
// item), mesmo padrao de PurchaseItem.quantityReceived.
model SaleItem {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  saleId           String    @map("sale_id") @db.Uuid
  productVariantId String    @map("product_variant_id") @db.Uuid
  quantity         Decimal   @db.Decimal(14, 3)
  unitPrice        Decimal   @map("unit_price") @db.Decimal(14, 2)
  discount         Decimal   @default(0) @db.Decimal(14, 2)
  // Congelado na confirmacao (RN 10.10.9/10.10.10) — o CMV historico nunca
  // muda quando o custo atual do produto muda.
  unitCostAtSale   Decimal?  @map("unit_cost_at_sale") @db.Decimal(14, 4)
  quantityReturned Decimal   @default(0) @map("quantity_returned") @db.Decimal(14, 3)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  company        Company          @relation(fields: [companyId], references: [id])
  sale           Sale             @relation(fields: [saleId], references: [id])
  productVariant ProductVariant   @relation(fields: [productVariantId], references: [id])
  createdByUser  User?            @relation("SaleItemCreatedBy", fields: [createdBy], references: [id])
  returnItems    SaleReturnItem[]

  @@index([companyId, saleId])
  @@map("sale_items")
}

// Criado so' na confirmacao — imutavel dali em diante (sem updated_at,
// mesma logica de PurchaseReceipt).
model SalePayment {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  saleId          String    @map("sale_id") @db.Uuid
  paymentMethodId String    @map("payment_method_id") @db.Uuid
  amount          Decimal   @db.Decimal(14, 2)
  feeAmount       Decimal   @default(0) @map("fee_amount") @db.Decimal(14, 2)
  netAmount       Decimal   @map("net_amount") @db.Decimal(14, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at")

  company       Company       @relation(fields: [companyId], references: [id])
  sale          Sale          @relation(fields: [saleId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  createdByUser User?         @relation("SalePaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId, saleId])
  @@map("sale_payments")
}

// Evento de devolucao (imutavel, sem updated_at — mesma logica de
// PurchaseReceipt).
model SaleReturn {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  saleId    String    @map("sale_id") @db.Uuid
  reason    String
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  company       Company          @relation(fields: [companyId], references: [id])
  sale          Sale             @relation(fields: [saleId], references: [id])
  createdByUser User?            @relation("SaleReturnCreatedBy", fields: [createdBy], references: [id])
  items         SaleReturnItem[]

  @@index([companyId, saleId])
  @@map("sale_returns")
}

// condition=damaged nunca volta ao estoque disponivel nesta fase (nao ha
// bucket de "estoque indisponivel" ainda — decisao explicita do plano da
// Fase 3).
enum SaleReturnItemCondition {
  apt
  damaged
}

model SaleReturnItem {
  id               String                  @id @default(uuid()) @db.Uuid
  companyId        String                  @map("company_id") @db.Uuid
  saleReturnId     String                  @map("sale_return_id") @db.Uuid
  saleItemId       String                  @map("sale_item_id") @db.Uuid
  productVariantId String                  @map("product_variant_id") @db.Uuid
  quantity         Decimal                 @db.Decimal(14, 3)
  condition        SaleReturnItemCondition
  createdAt        DateTime                @default(now()) @map("created_at")
  createdBy        String?                 @map("created_by") @db.Uuid
  deletedAt        DateTime?               @map("deleted_at")

  company        Company        @relation(fields: [companyId], references: [id])
  saleReturn     SaleReturn     @relation(fields: [saleReturnId], references: [id])
  saleItem       SaleItem       @relation(fields: [saleItemId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  createdByUser  User?          @relation("SaleReturnItemCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId, saleReturnId])
  @@map("sale_return_items")
}

// ---------------------------------------------------------------------------
// Financeiro: FinancialAccount, CashFlow, Receivables, Payables, Expenses
// (docs/architecture/overview.md, secao 6.6) — Fase 4 do roadmap. Escopo
// desta fase: modulos financeiros standalone + retrofit pontual do Sales
// (venda a vista gera FinancialTransaction real). Venda a prazo gerando
// Receivable automatico e compra gerando Payable automatico ficam pra
// depois — ver plano da Fase 4.
// ---------------------------------------------------------------------------

enum FinancialAccountStatus {
  active
  inactive
}

// Saldo nunca e' materializado aqui — sempre calculado por agregacao de
// FinancialTransaction (RN 10.13.3), evitando mais uma tabela pra
// reconciliar.
model FinancialAccount {
  id        String                 @id @default(uuid()) @db.Uuid
  companyId String                 @map("company_id") @db.Uuid
  name      String
  status    FinancialAccountStatus @default(active)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  createdBy String?                @map("created_by") @db.Uuid
  deletedAt DateTime?              @map("deleted_at")

  company               Company                @relation(fields: [companyId], references: [id])
  createdByUser         User?                  @relation("FinancialAccountCreatedBy", fields: [createdBy], references: [id])
  paymentMethods        PaymentMethod[]
  financialTransactions FinancialTransaction[]
  transfersFrom         Transfer[]             @relation("TransferFromAccount")
  transfersTo           Transfer[]             @relation("TransferToAccount")
  receivablePayments    ReceivablePayment[]
  payablePayments       PayablePayment[]
  expenses              Expense[]

  @@index([companyId, status])
  @@map("financial_accounts")
}

enum FinancialTransactionType {
  in
  out
  transfer
  adjustment
}

enum FinancialTransactionOriginType {
  sale_payment
  receivable_payment
  payable_payment
  expense
  transfer
  adjustment
}

// Lancamento realizado de caixa — IMUTAVEL apos criado (regra de
// integridade no 10 do Documento de Negocio). Sem updated_at/deleted_at,
// mesma logica de stock_movements.
model FinancialTransaction {
  id                 String                         @id @default(uuid()) @db.Uuid
  companyId          String                         @map("company_id") @db.Uuid
  financialAccountId String                         @map("financial_account_id") @db.Uuid
  type               FinancialTransactionType
  amount             Decimal                        @db.Decimal(14, 2)
  originType         FinancialTransactionOriginType @map("origin_type")
  originId           String                         @map("origin_id") @db.Uuid
  description        String?
  occurredAt         DateTime                       @default(now()) @map("occurred_at")
  createdAt          DateTime                       @default(now()) @map("created_at")
  createdBy          String?                        @map("created_by") @db.Uuid

  company          Company          @relation(fields: [companyId], references: [id])
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])
  createdByUser    User?            @relation("FinancialTransactionCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId, financialAccountId])
  @@map("financial_transactions")
}

// Transferencia entre contas proprias — nunca e' receita/despesa
// (RN 10.13.2/10.16.5). Gera duas FinancialTransaction (saida da origem,
// entrada no destino) com originType=transfer e originId = este Transfer.
model Transfer {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  fromAccountId String   @map("from_account_id") @db.Uuid
  toAccountId   String   @map("to_account_id") @db.Uuid
  amount        Decimal  @db.Decimal(14, 2)
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Uuid

  company       Company          @relation(fields: [companyId], references: [id])
  fromAccount   FinancialAccount @relation("TransferFromAccount", fields: [fromAccountId], references: [id])
  toAccount     FinancialAccount @relation("TransferToAccount", fields: [toAccountId], references: [id])
  createdByUser User?            @relation("TransferCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId])
  @@map("transfers")
}

enum ReceivableStatus {
  pending
  partially_received
  received
  cancelled
}

// "Vencida" (RN 10.14.3) e' computado na leitura (dueDate < hoje e status
// pendente/parcial) — sem job agendado no projeto ainda, sem status
// `overdue` armazenado.
model Receivable {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  customerId     String?          @map("customer_id") @db.Uuid
  // Preparado para uma futura venda a prazo (nao usado ainda — Fase 3 e'
  // so' a vista). Ver plano da Fase 4.
  saleId         String?          @map("sale_id") @db.Uuid
  description    String
  amountOriginal Decimal          @map("amount_original") @db.Decimal(14, 2)
  amountReceived Decimal          @default(0) @map("amount_received") @db.Decimal(14, 2)
  dueDate        DateTime         @map("due_date")
  status         ReceivableStatus @default(pending)
  cancelReason   String?          @map("cancel_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  createdBy      String?          @map("created_by") @db.Uuid
  deletedAt      DateTime?        @map("deleted_at")

  company       Company             @relation(fields: [companyId], references: [id])
  customer      Customer?           @relation(fields: [customerId], references: [id])
  sale          Sale?               @relation(fields: [saleId], references: [id])
  createdByUser User?               @relation("ReceivableCreatedBy", fields: [createdBy], references: [id])
  payments      ReceivablePayment[]

  @@index([companyId, status])
  @@map("receivables")
}

// Imutavel apos criado (mesma logica de FinancialTransaction).
model ReceivablePayment {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  receivableId       String   @map("receivable_id") @db.Uuid
  financialAccountId String   @map("financial_account_id") @db.Uuid
  amount             Decimal  @db.Decimal(14, 2)
  interest           Decimal? @db.Decimal(14, 2)
  discount           Decimal? @db.Decimal(14, 2)
  paidAt             DateTime @default(now()) @map("paid_at")
  createdAt          DateTime @default(now()) @map("created_at")
  createdBy          String?  @map("created_by") @db.Uuid

  company          Company          @relation(fields: [companyId], references: [id])
  receivable       Receivable       @relation(fields: [receivableId], references: [id])
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])
  createdByUser    User?            @relation("ReceivablePaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId, receivableId])
  @@map("receivable_payments")
}

enum PayableStatus {
  pending
  partially_paid
  paid
  cancelled
}

model Payable {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  supplierId     String?       @map("supplier_id") @db.Uuid
  description    String
  amountOriginal Decimal       @map("amount_original") @db.Decimal(14, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  dueDate        DateTime      @map("due_date")
  status         PayableStatus @default(pending)
  cancelReason   String?       @map("cancel_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  createdBy      String?       @map("created_by") @db.Uuid
  deletedAt      DateTime?     @map("deleted_at")

  company       Company          @relation(fields: [companyId], references: [id])
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  // Lado virtual do vinculo 1:1 — o FK real (payable_id) fica em Expense.
  expense       Expense?
  createdByUser User?            @relation("PayableCreatedBy", fields: [createdBy], references: [id])
  payments      PayablePayment[]

  @@index([companyId, status])
  @@map("payables")
}

model PayablePayment {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  payableId          String   @map("payable_id") @db.Uuid
  financialAccountId String   @map("financial_account_id") @db.Uuid
  amount             Decimal  @db.Decimal(14, 2)
  interest           Decimal? @db.Decimal(14, 2)
  discount           Decimal? @db.Decimal(14, 2)
  paidAt             DateTime @default(now()) @map("paid_at")
  createdAt          DateTime @default(now()) @map("created_at")
  createdBy          String?  @map("created_by") @db.Uuid

  company          Company          @relation(fields: [companyId], references: [id])
  payable          Payable          @relation(fields: [payableId], references: [id])
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])
  createdByUser    User?            @relation("PayablePaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId, payableId])
  @@map("payable_payments")
}

enum ExpenseCategory {
  mercadorias
  frete
  embalagem
  publicidade
  plataforma
  telefone
  internet
  aluguel
  energia
  transporte
  combustivel
  taxa
  imposto
  manutencao
  pro_labore
  retirada
  despesa_administrativa
  perda
  outra
}

enum ExpenseStatus {
  pending
  paid
  cancelled
}

// Criada ja paga (paidNow=true no DTO) gera uma FinancialTransaction de
// saida direto; criada como despesa futura gera automaticamente um Payable
// vinculado (RN 10.15.3) — pagar depois e' pagar esse Payable, sem endpoint
// de pagamento duplicado aqui.
model Expense {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  description        String
  category           ExpenseCategory
  amount             Decimal         @db.Decimal(14, 2)
  competenceDate     DateTime        @map("competence_date")
  dueDate            DateTime?       @map("due_date")
  paidAt             DateTime?       @map("paid_at")
  financialAccountId String?         @map("financial_account_id") @db.Uuid
  status             ExpenseStatus   @default(pending)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  createdBy          String?         @map("created_by") @db.Uuid
  deletedAt          DateTime?       @map("deleted_at")

  company          Company           @relation(fields: [companyId], references: [id])
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  createdByUser    User?             @relation("ExpenseCreatedBy", fields: [createdBy], references: [id])
  payable          Payable?          @relation(fields: [payableId], references: [id])
  payableId        String?           @unique @map("payable_id") @db.Uuid

  @@index([companyId, status])
  @@map("expenses")
}
